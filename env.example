# ============================================================
#  BitcoLi2 – konfigurace prostředí
#  Zkopírujte tento soubor jako .env a vyplňte hodnoty.
#  Soubor .env NIKDY necommitujte do gitu.
# ============================================================

# --- Databáze (MariaDB) --------------------------------------
# Heslo root účtu MariaDB
MYSQL_ROOT_PASSWORD=change_me_strong_password

# Aplikační uživatel (méně privilegovaný než root)
MYSQL_USER=bitcoli
MYSQL_PASSWORD=change_me_app_password

# Název databáze – obvykle není důvod měnit
MYSQL_DATABASE=bitcoliv2

# Hostname MariaDB kontejneru (musí odpovídat container_name v docker-compose.yml)
BITCOLI_MYSQL_HOST=bitcoli-db

# Uživatel, kterým se PHP připojuje k DB
# Doporučeno: stejný jako MYSQL_USER výše (ne root)
BITCOLI_MYSQL_USER=bitcoli
BITCOLI_MYSQL_PSWD=change_me_app_password

# --- Lightning Network (LND) ----------------------------------
# Adresa LND REST API, formát host:port
LND_HOST=192.168.1.X:8080

# Cesta k admin.macaroon UVNITŘ kontejneru (volume mount níže)
LND_MACAROON=/data/lnd/admin.macaroon

# Cesta k admin.macaroon NA HOSTU (pro volume mount v docker-compose.yml)
LND_MACAROON_HOST_PATH=/home/umbrel/umbrel/app-data/lightning/data/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# --- Datové adresáře (cesty uvnitř kontejneru) ---------------
BITCOLI_KEYS_DIR=/data/keys
BITCOLI_BACKUPS_DIR=/data/backups
BITCOLI_TOR_DIR=/data/tor

# --- Tor -----------------------------------------------------
# Onion adresa tohoto nodu (pokud není vyplněno, přečte se z BITCOLI_TOR_DIR/hostname)
BITCOLI_TOR_HOST=
# SOCKS5 proxy pro odchozí Tor spojení
BITCOLI_TOR_PROXY=bitcoli-tor:9050
